{
  "name": "amazin-be",
  "type": "module",
  "version": "1.0.0",
  "description": "Ecommerce website, amazon clone backend service",
  "main": "server.js",
  "scripts": {
    "build": "npm cache clean --force && npm install",
    "start": "node --experimental-loader newrelic/esm-loader.mjs -r newrelic server.js",
    "devstart": "nodemon --watch --exec node --experimental-modules --experimental-loader newrelic/esm-loader.mjs -r newrelic server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "prepare": "husky",
    "migrate": "migrate-mongo up -f migrate-mongo-config.cjs",
    "migrate:status": "migrate-mongo status -f migrate-mongo-config.cjs",
    "migrate:create": "migrate-mongo create -f migrate-mongo-config.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntrix/amazin-be.git"
  },
  "author": "ntien",
  "license": "ISC",
  "homepage": "https://github.com/ntrix/amazin#readme",
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "mongoose-float": {
      "mongoose": "$mongoose"
    }
  },
  "dependencies": {
    "@sendgrid/mail": "^7.4.6",
    "@sentry/node": "^10.75.0",
    "axios": "^0.21.4",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^3.4.4",
    "cloudinary": "^1.27.0",
    "cors": "^2.8.5",
    "dotenv": "^8.6.0",
    "express": "^4.18.2",
    "express-async-handler": "^1.1.4",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^6.12.1",
    "helmet": "^4.6.0",
    "jsonwebtoken": "^8.5.1",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^8.24.4",
    "mongoose-float": "^1.0.4",
    "multer": "^1.4.3",
    "newrelic": "^14.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^7.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^2.0.22",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "bugs": {
    "url": "https://github.com/ntrix/amazin/issues"
  },
  "allowScripts": {
    "mongodb-memory-server@11.2.0": true
  }
}
