# Full setup instructions for each of these: README.md > "Environment variables"

# --- Required ---
MONGODB_URL=mongodb://localhost/amazin
JWT_SECRET_A=
JWT_REFRESH_SECRET=

# --- Required for image upload ---
CD_NAME=
CD_API_KEY=
CD_API_SECRET=

# --- Required for shipping address picker ---
GOOGLE_API_KEY=

# --- Required for currency conversion ---
RATES_API_KEY=

# --- Required for contact form ---
SENDGRID_API_KEY=
FROMMAIL=
TOMAIL=

# --- Optional (has a working fallback) ---
# REDIS_URL unset -> login-lockout is skipped entirely (fails open), no other feature depends on it
REDIS_URL=redis://localhost:6379
PAYPAL_CLIENT_ID=
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=100
LOG_LEVEL=info

# --- Optional (feature disabled if unset) ---
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
ATLAS_SEARCH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/users/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/users/auth/github/callback
FE_ORIGIN=http://localhost:3000
