# Full setup instructions for each of these: README.md > "Environment variables"

# --- Required ---
MONGODB_URL=mongodb://localhost/amazin
JWT_SECRET_A=

# --- Required for image upload ---
CD_NAME=
CD_API_KEY=
CD_API_SECRET=

# --- Required for shipping address picker ---
GOOGLE_API_KEY=

# --- Required for currency conversion ---
RATES_API_KEY=

# --- Required for contact form ---
SENDGRID_API_KEY=
FROMMAIL=
TOMAIL=

# --- Optional (has a working fallback) ---
PAYPAL_CLIENT_ID=
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=100
LOG_LEVEL=info

# --- Optional (feature disabled if unset) ---
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
ATLAS_SEARCH_ENABLED=false
